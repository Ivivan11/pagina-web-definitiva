# Claude / Anthropic (facturación por uso, independiente de tu suscripción a claude.ai)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# Twilio (telefonía)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
MY_PHONE_NUMBER=+34XXXXXXXXX

# URL pública donde Twilio puede llegar a este servidor (ngrok/cloudflared en local, o tu dominio en producción)
PUBLIC_BASE_URL=https://tu-tunel-o-dominio.example.com

# Google (Gmail + Calendar). Se generan en Google Cloud Console -> OAuth Client (tipo "Desktop app")
# y luego con un script tipo OAuth Playground para sacar el refresh_token con los scopes:
#   https://www.googleapis.com/auth/gmail.modify
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

PORT=3000
